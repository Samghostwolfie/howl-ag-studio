# Copy this file to ".env" and fill it in. Never share or commit the real .env.

# --- local development ---------------------------------------------------
PORT=3000

# --- security (REQUIRED once the site is public) -------------------------
# A long random string. Anything unguessable, 40+ characters.
SESSION_SECRET=change-me-to-something-long-and-random

# Your admin login. Set these BEFORE the first run on a new server —
# the account is created from them the first time the app starts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Where the admin panel lives. Leave blank for /admin.
# Set it to something only you know so bots scanning for /admin find nothing.
ADMIN_PATH=

# --- Firebase (RECOMMENDED for production) --------------------------------
# Go to Firebase Console > Project Settings > Service Accounts > Generate New
# Private Key. Copy the values from the downloaded JSON file.
#
# When these are set, data is stored in Firestore instead of local JSON files.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: set this to store uploaded images/builds in Firebase Storage
# instead of the local public/uploads/ folder. Use the bucket name from
# Firebase Console > Storage (e.g. your-project.appspot.com or
# your-project.firebasestorage.app).
FIREBASE_STORAGE_BUCKET=

# Alternative: point at a service account JSON file instead of the vars above.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- database (legacy) ---------------------------------------------------
# Leave EMPTY unless using Postgres. Firebase is now the recommended backend.
# On a host, paste your Neon/Supabase connection string here.
DATABASE_URL=

# --- optional ------------------------------------------------------------
SITE_URL=
STRIPE_SECRET_KEY=
