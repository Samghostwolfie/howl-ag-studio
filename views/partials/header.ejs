<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' && title ? title + ' — ' + studio.name : studio.name %></title>
  <meta name="description" content="<%= studio.pitch ? studio.pitch.slice(0,155) : '' %>" />
  <link rel="icon" href="/img/favicon.png" />
  <link rel="apple-touch-icon" href="/img/logo-wolf-180.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="noise-layer" aria-hidden="true"></div>

  <% var s = studio.socials || {}; %>
  <% if (s.x || s.discord || s.youtube || s.instagram) { %>
    <div class="social-rail">
      <% if (s.x) { %><a href="<%= s.x %>" target="_blank" rel="noopener">Twitter</a><% } %>
      <% if (s.discord) { %><a href="<%= s.discord %>" target="_blank" rel="noopener">Discord</a><% } %>
      <% if (s.youtube) { %><a href="<%= s.youtube %>" target="_blank" rel="noopener">YouTube</a><% } %>
      <% if (s.instagram) { %><a href="<%= s.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %>
    </div>
  <% } %>

  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">
        <%- include('logo', { id: 'hdr', size: 32 }) %>
        <span class="brand-name"><%= studio.name %><span class="sub">Game Studio</span></span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav class="site-nav" id="siteNav">
        <a href="/" class="<%= path === '/' ? 'active' : '' %>">Intro</a>
        <a href="/work" class="<%= path === '/work' ? 'active' : '' %>">Work</a>
        <a href="/devlog" class="<%= path.indexOf('/devlog') === 0 ? 'active' : '' %>">Devlog</a>
        <a href="/news" class="<%= path.indexOf('/news') === 0 ? 'active' : '' %>">News</a>
        <a href="/team" class="<%= path === '/team' ? 'active' : '' %>">Team</a>
        <a href="/about" class="<%= path === '/about' ? 'active' : '' %>">About</a>
        <a href="/wishlist" class="nav-cta <%= path === '/wishlist' ? 'active' : '' %>">Wishlist</a>
      </nav>
    </div>
  </header>

  <% if (typeof success !== 'undefined' && success && success.length) { %>
    <div class="container"><div class="flash flash-success"><% success.forEach(function(m){ %><p><%= m %></p><% }) %></div></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error && error.length) { %>
    <div class="container"><div class="flash flash-error"><% error.forEach(function(m){ %><p><%= m %></p><% }) %></div></div>
  <% } %>

  <main>
