<%- include('partials/header') %>

<%
  // Everything below comes pre-computed from the server (see normalizeGame in server.js).
  var media    = game.media || [];
  var features = (game.features || '').split('\n').map(function (f) { return f.trim(); }).filter(Boolean);
  var tags     = game.tags || [];
  var others   = (typeof otherGames !== 'undefined' && otherGames) ? otherGames : [];
%>

<section class="game-top">
  <div class="container">
    <p class="breadcrumb"><a href="/">Home</a> &nbsp;/&nbsp; <a href="/work">Work</a> &nbsp;/&nbsp; <%= game.title %></p>
    <div class="game-title-row">
      <h1><%= game.title %></h1>
      <div class="game-title-meta">
        <span class="badge status-<%= game.status %>"><%= game.statusLabel %></span>
        <% if (game.wishlistEnabled) { %><span class="badge badge-wish">Wishlist Open</span><% } %>
        <% if (game.genre) { %><span class="tag"><%= game.genre %></span><% } %>
      </div>
    </div>
  </div>
</section>

<section class="stage" id="trailer">
  <div class="container stage-grid">

    <!-- ---------- media ---------- -->
    <div>
      <div class="media-stage" id="mediaStage">
        <% if (media.length) { %>
          <% var first = media[0]; %>
          <% if (first.type === 'video' && first.mode === 'iframe') { %>
            <iframe src="<%= first.src %>" title="<%= game.title %> video" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy" referrerpolicy="no-referrer"></iframe>
          <% } else if (first.type === 'video') { %>
            <video src="<%= first.src %>" controls preload="metadata" <%= first.poster ? 'poster=' + first.poster : '' %>></video>
          <% } else { %>
            <img src="<%= first.src %>" alt="<%= game.title %> artwork" referrerpolicy="no-referrer" />
          <% } %>
        <% } else { %>
          <span class="media-empty"><%- include('partials/logo', { id: 'stage', size: 64 }) %></span>
        <% } %>
      </div>

      <% if (media.length > 1) { %>
        <div class="media-thumbs" id="mediaThumbs">
          <% media.forEach(function (m, i) { %>
            <button type="button" class="<%= i === 0 ? 'active' : '' %>"
                    data-type="<%= m.type %>" data-mode="<%= m.mode %>" data-src="<%= m.src %>"
                    data-poster="<%= m.poster || '' %>" aria-label="View media <%= i + 1 %>">
              <% if (m.type === 'video') { %>
                <% if (m.poster) { %><img src="<%= m.poster %>" alt="" referrerpolicy="no-referrer" /><% } %>
                <span class="thumb-video">
                  <svg width="16" height="18" viewBox="0 0 12 14" fill="currentColor" aria-hidden="true"><path d="M0 0l12 7-12 7z"/></svg>
                </span>
              <% } else { %>
                <img src="<%= m.src %>" alt="" loading="lazy" referrerpolicy="no-referrer" />
              <% } %>
            </button>
          <% }) %>
        </div>
      <% } %>

      <!-- ---------- action band ---------- -->
      <% if (game.isReleased) { %>
        <div class="buy-band <%= game.pricingType === 'free' ? 'free' : '' %>">
          <div class="buy-left">
            <h4><%= game.pricingType === 'free' ? 'Play it now — on the house' : 'Buy ' + game.title %></h4>
            <p><%= game.pricingType === 'free' ? 'Free download, no strings attached.' : 'One-time purchase. Yours forever.' %></p>
          </div>
          <div class="buy-right">
            <span class="price-tag <%= game.pricingType === 'free' ? 'free-tag' : '' %>">
              <%= game.pricingType === 'free' ? 'FREE' : '$' + Number(game.price).toFixed(2) %>
            </span>
            <a href="/games/<%= game.slug %>/buy" class="btn btn-primary btn-lg">
              <%= game.pricingType === 'free' ? 'Download now' : 'Buy now' %>
            </a>
          </div>
        </div>
      <% } else if (game.isDemo) { %>
        <div class="buy-band free">
          <div class="buy-left">
            <h4>Try the demo</h4>
            <p>A playable slice while the full game is still in development.</p>
          </div>
          <div class="buy-right">
            <span class="price-tag free-tag">DEMO</span>
            <a href="/games/<%= game.slug %>/buy" class="btn btn-primary btn-lg">Play the demo</a>
          </div>
        </div>
      <% } else { %>
        <div class="buy-band dev">
          <div class="buy-left">
            <h4><%= game.status === 'prototype' ? 'Prototype in progress' : 'Currently in development' %></h4>
            <p><%= game.wishlistEnabled
                  ? 'Not out yet — wishlist it and we’ll tell you the moment it is.'
                  : 'Not available yet. Follow the studio for updates.' %></p>
          </div>
          <% if (game.wishlistEnabled) { %>
            <div class="buy-right">
              <span class="price-tag free-tag"><%= game.wishlistCount.toLocaleString() %></span>
              <span class="buy-note">people<br />wishlisted</span>
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- ---------- Fundraiser & Crowdfunding Band ---------- -->
      <% if (game.fundraiser && game.fundraiser.enabled && game.fundraiser.status !== 'closed') { %>
        <section id="fundraiser" class="fundraiser-band">
          <% if (game.fundraiser.status === 'warn') { %>
            <!-- Warning Notice Banner (When status is 'warn') -->
            <div class="fundraiser-hold-banner" role="alert">
              <div class="fundraiser-hold-icon" aria-hidden="true">⚠️</div>
              <div class="fundraiser-hold-body">
                <div class="fundraiser-hold-title">DO NOT DONATE HERE &mdash; FEATURE CURRENTLY UNDER DEVELOPMENT</div>
                <p class="fundraiser-hold-desc">The fundraiser &amp; donation system is temporarily on hold while payment integrations and backer features are being finalized. Contributions cannot be accepted at this time.</p>
              </div>
              <div class="fundraiser-hold-badge">ON HOLD</div>
            </div>
          <% } %>

          <div class="fundraiser-header">
            <div>
              <span class="fundraiser-tag">🐺 <%= game.fundraiser.title || 'Development Fundraiser' %></span>
              <h3 class="fundraiser-title">Support the Creation of <%= game.title %></h3>
              <% if (game.fundraiser.pitch) { %>
                <p class="fundraiser-pitch"><%= game.fundraiser.pitch %></p>
              <% } else { %>
                <p class="fundraiser-pitch">Back this game directly to help fund art, sound, and expanded features.</p>
              <% } %>
            </div>
            <div>
              <% if (game.fundraiser.status === 'warn') { %>
                <span class="fundraiser-status-pill">
                  <span class="pulse-dot-warn"></span> Donations Paused (Under Dev)
                </span>
              <% } else { %>
                <button type="button" class="btn btn-primary donate-toggle-btn" onclick="var p = document.getElementById('donationPanel'); if(p){ p.scrollIntoView({behavior:'smooth'}); var i = document.getElementById('donationAmountInput'); if(i) i.focus(); }">
                  Back this Game
                </button>
              <% } %>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="fundraiser-progress-wrap">
            <div class="fundraiser-track" role="progressbar" aria-valuenow="<%= game.fundraiser.percentFunded %>" aria-valuemin="0" aria-valuemax="100">
              <div class="fundraiser-fill" style="width: <%= Math.min(100, Math.max(game.fundraiser.percentFunded, (game.fundraiser.totalRaised > 0 ? 3 : 0))) %>%;"></div>
            </div>
            <div class="fundraiser-metrics">
              <div class="fundraiser-metric">
                <span class="fundraiser-metric-num">$<%= Number(game.fundraiser.totalRaised).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) %></span>
                <span class="fundraiser-metric-label">raised of $<%= Number(game.fundraiser.goal).toLocaleString('en-US') %> goal</span>
              </div>
              <div class="fundraiser-metric">
                <span class="fundraiser-metric-num"><%= game.fundraiser.percentFunded %>%</span>
                <span class="fundraiser-metric-label">funded</span>
              </div>
              <div class="fundraiser-metric">
                <span class="fundraiser-metric-num"><%= game.fundraiser.donorCount %></span>
                <span class="fundraiser-metric-label">backers</span>
              </div>
            </div>
          </div>

          <!-- Donation Form Panel -->
          <% if (game.fundraiser.status === 'warn') { %>
            <div id="donationPanel" class="donation-form-panel donation-form-paused">
              <div class="donation-paused-notice">
                <span class="donation-paused-icon">⚠️</span>
                <div>
                  <strong style="color: var(--warn); display: block; font-size: 0.95rem; margin-bottom: 2px;">Notice: Do Not Donate Here</strong>
                  <span style="font-size: 0.84rem; color: var(--grey);">This fundraiser is in preview mode and contributions are on hold until payment processing is fully functional.</span>
                </div>
              </div>

              <form class="feedback-form" action="/games/<%= game.slug %>/donate" method="POST" onsubmit="return false;" style="background: var(--panel-2); padding: 22px; border-radius: 8px; opacity: 0.7;">
                <fieldset disabled style="border: none; margin: 0; padding: 0;">
                  <button type="button" class="btn btn-secondary btn-block" disabled style="padding: 14px; font-size: 0.95rem; font-weight: 700; letter-spacing: 0.06em; cursor: not-allowed; opacity: 0.75;">
                    ⚠️ Donations Temporarily On Hold (Under Development)
                  </button>
                </fieldset>
              </form>
            </div>
          <% } else { %>
            <div id="donationPanel" class="donation-form-panel">
              <h4 style="margin: 0 0 8px; font-size: 1.15rem; color: var(--white);">Make a Contribution</h4>
              <p style="margin: 0 0 14px; font-size: 0.86rem; color: var(--grey-dim);">Choose an amount or enter your own. Secure checkout powered by Stripe.</p>

              <form class="feedback-form" action="/games/<%= game.slug %>/donate" method="POST" style="background: var(--panel-2); padding: 24px; border-radius: 8px;">
                <div class="amount-presets">
                  <button type="button" class="amount-chip" onclick="setDonationAmount(10)">$10</button>
                  <button type="button" class="amount-chip active" onclick="setDonationAmount(25)">$25</button>
                  <button type="button" class="amount-chip" onclick="setDonationAmount(50)">$50</button>
                  <button type="button" class="amount-chip" onclick="setDonationAmount(100)">$100</button>
                  <button type="button" class="amount-chip" onclick="setDonationAmount(250)">$250</button>
                </div>

                <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                  <label>
                    <span style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--grey); margin-bottom: 5px;">Contribution Amount (USD $)</span>
                    <input type="number" id="donationAmountInput" name="amount" min="1" step="any" value="25" required />
                  </label>
                  <label>
                    <span style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--grey); margin-bottom: 5px;">Your Name</span>
                    <input type="text" name="donorName" placeholder="Your name (e.g. Alex)" maxlength="80" />
                  </label>
                </div>

                <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                  <label>
                    <span style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--grey); margin-bottom: 5px;">Email <em style="color:var(--grey-dim);font-size:0.75rem;">(private, for receipt)</em></span>
                    <input type="email" name="donorEmail" placeholder="you@email.com" />
                  </label>
                  <label style="display: flex; align-items: center; gap: 8px; margin-top: 24px; cursor: pointer;">
                    <input type="checkbox" name="isAnonymous" style="width: auto;" />
                    <span style="font-size: 0.84rem; color: var(--grey);">Hide my name on the public backer list</span>
                  </label>
                </div>

                <label>
                  <span style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--grey); margin-bottom: 5px;">Message / Note to the Devs <em style="color:var(--grey-dim);font-size:0.75rem;">(optional)</em></span>
                  <textarea name="message" rows="2" maxlength="400" placeholder="Cheer on the team or share what excites you about this game..."></textarea>
                </label>

                <!-- Payment Methods Selector List -->
                <div class="payment-methods-section">
                  <div class="payment-methods-header">
                    <h5 class="payment-methods-title">
                      <span>💳 Payment Method</span>
                    </h5>
                    <span class="payment-security-tag">🔒 256-bit SSL Encrypted</span>
                  </div>

                  <div class="payment-methods-list">
                    <!-- Option 1: Credit or Debit Card -->
                    <label class="payment-option-card active" onclick="selectPaymentMethod('card')">
                      <input type="radio" name="paymentMethod" value="card" checked style="display:none;" />
                      <div class="payment-radio-custom"></div>
                      <div class="payment-brand-badge">
                        <svg viewBox="0 0 100 32" xmlns="http://www.w3.org/2000/svg"><text x="4" y="22" font-family="sans-serif" font-style="italic" font-weight="900" font-size="20" fill="#1A1F71">VISA</text><circle cx="68" cy="16" r="10" fill="#EB001B"/><circle cx="82" cy="16" r="10" fill="#F79E1B" fill-opacity="0.85"/></svg>
                      </div>
                      <div class="payment-option-info">
                        <div class="payment-option-name">
                          <span>Credit or Debit Card</span>
                          <span class="payment-fast-tag">Popular</span>
                        </div>
                        <div class="payment-option-sub">Visa, Mastercard, American Express, Discover</div>
                      </div>
                    </label>

                    <!-- Option 2: Google Pay -->
                    <label class="payment-option-card" onclick="selectPaymentMethod('google_pay')">
                      <input type="radio" name="paymentMethod" value="google_pay" style="display:none;" />
                      <div class="payment-radio-custom"></div>
                      <div class="payment-brand-badge">
                        <svg viewBox="0 0 100 40" xmlns="http://www.w3.org/2000/svg"><path d="M43.7 20.3c0-.6 0-1.2-.1-1.7H32.4v3.3h6.4c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.4-5.2 3.4-8.2z" fill="#4285F4"/><path d="M32.4 31.8c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.4 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H21.7v3.1c2 3.9 6.1 6.5 10.7 6.5z" fill="#34A853"/><path d="M25.8 22.2c-.2-.7-.4-1.5-.4-2.2s.2-1.5.4-2.2v-3.1h-4.1c-.8 1.7-1.3 3.5-1.3 5.3s.5 3.6 1.3 5.3l4.1-3.1z" fill="#FBBC04"/><path d="M32.4 12.1c1.8 0 3.3.6 4.6 1.8l3.4-3.4c-2.1-2-4.8-3.1-8-3.1-4.6 0-8.7 2.6-10.7 6.5l4.1 3.1c.9-2.8 3.5-4.9 6.6-4.9z" fill="#EA4335"/><text x="47" y="27" font-family="sans-serif" font-weight="bold" font-size="20" fill="#3c4043">Pay</text></svg>
                      </div>
                      <div class="payment-option-info">
                        <div class="payment-option-name">
                          <span>Google Pay</span>
                          <span class="payment-fast-tag">Instant</span>
                        </div>
                        <div class="payment-option-sub">Fast 1-click checkout with your Google account</div>
                      </div>
                    </label>

                    <!-- Option 3: Apple Pay -->
                    <label class="payment-option-card" onclick="selectPaymentMethod('apple_pay')">
                      <input type="radio" name="paymentMethod" value="apple_pay" style="display:none;" />
                      <div class="payment-radio-custom"></div>
                      <div class="payment-brand-badge dark-badge">
                        <svg viewBox="0 0 100 40" xmlns="http://www.w3.org/2000/svg"><path d="M33.6 20.2c0-3.3 2.7-4.9 2.8-5-1.5-2.2-4-2.5-4.8-2.6-2-.2-4 1.2-5 1.2-1.1 0-2.6-1.2-4.3-1.1-2.2 0-4.3 1.3-5.4 3.3-2.3 4-0.6 9.9 1.6 13.1 1.1 1.6 2.4 3.3 4.1 3.3 1.7 0 2.3-1.1 4.3-1.1 1.9 0 2.5 1.1 4.3 1.1 1.8 0 2.9-1.6 4-3.1 1.3-1.8 1.8-3.6 1.8-3.7-0.1 0-3.5-1.3-3.5-5.1zM29.5 10.5c0.9-1.1 1.5-2.6 1.3-4.2-1.3 0.1-2.9 0.9-3.8 2-0.8 0.9-1.5 2.5-1.3 4 1.5 0.1 2.9-0.8 3.8-1.8z" fill="#ffffff"/><text x="42" y="27" font-family="sans-serif" font-weight="600" font-size="20" fill="#ffffff">Pay</text></svg>
                      </div>
                      <div class="payment-option-info">
                        <div class="payment-option-name">
                          <span>Apple Pay</span>
                          <span class="payment-fast-tag">Touch ID</span>
                        </div>
                        <div class="payment-option-sub">Seamless checkout with Touch ID / Face ID on Apple devices</div>
                      </div>
                    </label>

                    <!-- Option 4: PayPal -->
                    <label class="payment-option-card" onclick="selectPaymentMethod('paypal')">
                      <input type="radio" name="paymentMethod" value="paypal" style="display:none;" />
                      <div class="payment-radio-custom"></div>
                      <div class="payment-brand-badge paypal-badge">
                        <svg viewBox="0 0 100 26" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12.2 3.1h-7.6c-.6 0-1.1.4-1.2 1l-3.3 21c0 .4.3.7.7.7h4.8c.6 0 1.1-.4 1.2-1l.9-5.9c.1-.6.6-1 1.2-1h2.5c5.2 0 8.3-2.5 9-7.3.4-2.1 0-3.8-1.1-4.9-1.3-1.6-3.7-2.6-6.6-2.6zm.9 7.4c-.4 2.8-2.5 2.8-4.5 2.8h-1.4l1-6.4c0-.2.2-.4.4-.4h1c1.3 0 2.6 0 3.2.7.5.7.5 1.8.3 3.3z" fill="#003087"/><path d="M33.6 8.5h-4.8c-.4 0-.8.3-.9.7l-.2 1.3-.4-.6c-.9-1.2-2.7-1.7-4.6-1.7-4.3 0-8 3.3-8.7 7.9-.4 2.4.2 4.6 1.6 6 1.3 1.3 3.1 1.8 5.2 1.8 3.7 0 5.7-2.4 5.7-2.4l-.2 1.4c0 .4.3.7.7.7h4.4c.5 0 .9-.4 1-1l2.4-15c.1-.6-.3-1.1-.9-1.1zm-4.7 7.7c-.4 2.3-2.2 3.9-4.5 3.9-1.1 0-2.1-.4-2.7-1.1-.6-.7-.8-1.7-.6-2.8.4-2.3 2.3-3.9 4.6-3.9 1.1 0 2 .4 2.6 1.1.6.8.8 1.8.6 2.8z" fill="#0079C1"/><text x="42" y="19" font-family="sans-serif" font-weight="900" font-size="16" fill="#003087">Pay</text><text x="70" y="19" font-family="sans-serif" font-weight="900" font-size="16" fill="#0079C1">Pal</text></svg>
                      </div>
                      <div class="payment-option-info">
                        <div class="payment-option-name">
                          <span>PayPal</span>
                        </div>
                        <div class="payment-option-sub">Pay via PayPal balance or linked bank account</div>
                      </div>
                    </label>

                    <!-- Option 5: Klarna / Flexible Split -->
                    <label class="payment-option-card" onclick="selectPaymentMethod('klarna')">
                      <input type="radio" name="paymentMethod" value="klarna" style="display:none;" />
                      <div class="payment-radio-custom"></div>
                      <div class="payment-brand-badge klarna-badge">
                        <svg viewBox="0 0 100 32" xmlns="http://www.w3.org/2000/svg"><text x="6" y="23" font-family="sans-serif" font-weight="900" font-size="21" fill="#0A0B09">Klarna.</text></svg>
                      </div>
                      <div class="payment-option-info">
                        <div class="payment-option-name">
                          <span>Klarna</span>
                          <span class="payment-split-tag" id="klarnaSplitText">Pay $6.25 today in 4 interest-free payments</span>
                        </div>
                        <div class="payment-option-sub">Flexible, interest-free installment options</div>
                      </div>
                    </label>

                    <!-- Option 6: Cash App Pay -->
                    <label class="payment-option-card" onclick="selectPaymentMethod('cashapp')">
                      <input type="radio" name="paymentMethod" value="cashapp" style="display:none;" />
                      <div class="payment-radio-custom"></div>
                      <div class="payment-brand-badge cashapp-badge">
                        <svg viewBox="0 0 100 32" xmlns="http://www.w3.org/2000/svg"><text x="10" y="22" font-family="sans-serif" font-weight="900" font-size="17" fill="#ffffff">$ Cash App</text></svg>
                      </div>
                      <div class="payment-option-info">
                        <div class="payment-option-name">
                          <span>Cash App Pay</span>
                        </div>
                        <div class="payment-option-sub">Scan QR or 1-tap mobile payment</div>
                      </div>
                    </label>
                  </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 14px;">
                  <button type="submit" id="donationSubmitBtn" class="btn btn-primary btn-block" style="padding: 15px; font-size: 1.05rem; font-weight: 700; letter-spacing: 0.05em; display:flex; align-items:center; justify-content:center; gap:8px;">
                    🐺 Back <%= game.title %> with Card • $25.00
                  </button>

                  <% if (game.fundraiser.paypalUrl) { %>
                    <a href="<%= game.fundraiser.paypalUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-block" style="padding: 12px; font-size: 0.92rem; font-weight: 700; text-align: center; text-decoration: none; border-color: #0070ba; color: #38bdf8;">
                      🅿️ Direct PayPal Donation Link &rarr;
                    </a>
                  <% } %>
                </div>
              </form>
            </div>
          <% } %>

          <!-- Public Donors Wall -->
          <% if (game.fundraiser.recentDonors && game.fundraiser.recentDonors.length) { %>
            <div class="donors-wall">
              <div class="donors-wall-title">
                <span>Recent Supporters (<%= game.fundraiser.donorCount %> total)</span>
                <span style="color: var(--acid);"><%= game.fundraiser.recentDonors.length %> shown</span>
              </div>
              <div class="donors-list">
                <% game.fundraiser.recentDonors.forEach(function (donor) { %>
                  <div class="donor-pill">
                    <span style="font-weight: 600;"><%= donor.name %></span>
                    <span class="donor-amt">$<%= Number(donor.amount).toFixed(2) %></span>
                    <% if (donor.message) { %>
                      <span class="donor-msg">“<%= donor.message %>”</span>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } else { %>
            <div class="donors-wall">
              <div class="donors-wall-title">
                <span>Supporters Wall</span>
              </div>
              <p style="margin: 0; font-size: 0.85rem; color: var(--grey-dim);">
                <% if (game.fundraiser.status === 'warn') { %>
                  Backer pledges will appear here once fundraising officially opens.
                <% } else { %>
                  Be the first backer to support <%= game.title %>!
                <% } %>
              </p>
            </div>
          <% } %>
        </section>

        <script>
          var currentPaymentMethod = 'card';

          function selectPaymentMethod(method) {
            currentPaymentMethod = method;
            var cards = document.querySelectorAll('.payment-option-card');
            cards.forEach(function(c) {
              var radio = c.querySelector('input[type="radio"]');
              if (radio && radio.value === method) {
                radio.checked = true;
                c.classList.add('active');
              } else {
                c.classList.remove('active');
              }
            });
            updateDonationUI();
          }

          function setDonationAmount(val) {
            var input = document.getElementById('donationAmountInput');
            if (input && !input.disabled) {
              input.value = val;
            }
            var chips = document.querySelectorAll('.amount-chip');
            chips.forEach(function(c) {
              if (c.textContent.trim() === '$' + val) {
                c.classList.add('active');
              } else {
                c.classList.remove('active');
              }
            });
            updateDonationUI();
          }

          function updateDonationUI() {
            var input = document.getElementById('donationAmountInput');
            var amt = input ? (parseFloat(input.value) || 25) : 25;
            if (amt < 1) amt = 1;
            var formatted = Number(amt).toFixed(2);

            // Update Klarna split text
            var klarnaSplit = document.getElementById('klarnaSplitText');
            if (klarnaSplit) {
              var splitAmt = (amt / 4).toFixed(2);
              klarnaSplit.textContent = 'Pay $' + splitAmt + ' today in 4 interest-free payments';
            }

            // Update Submit Button Label
            var btn = document.getElementById('donationSubmitBtn');
            if (btn) {
              var gameTitle = '<%= game.title %>';
              if (currentPaymentMethod === 'google_pay') {
                btn.innerHTML = '<svg style="height:18px;vertical-align:middle;margin-right:4px;" viewBox="0 0 100 40"><path d="M43.7 20.3c0-.6 0-1.2-.1-1.7H32.4v3.3h6.4c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.4-5.2 3.4-8.2z" fill="#4285F4"/><path d="M32.4 31.8c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.4 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H21.7v3.1c2 3.9 6.1 6.5 10.7 6.5z" fill="#34A853"/><path d="M25.8 22.2c-.2-.7-.4-1.5-.4-2.2s.2-1.5.4-2.2v-3.1h-4.1c-.8 1.7-1.3 3.5-1.3 5.3s.5 3.6 1.3 5.3l4.1-3.1z" fill="#FBBC04"/><path d="M32.4 12.1c1.8 0 3.3.6 4.6 1.8l3.4-3.4c-2.1-2-4.8-3.1-8-3.1-4.6 0-8.7 2.6-10.7 6.5l4.1 3.1c.9-2.8 3.5-4.9 6.6-4.9z" fill="#EA4335"/><text x="47" y="27" font-family="sans-serif" font-weight="bold" font-size="20" fill="#fff">Pay</text></svg> Pay $' + formatted + ' with Google Pay';
              } else if (currentPaymentMethod === 'apple_pay') {
                btn.innerHTML = ' Pay $' + formatted + ' with Apple Pay';
              } else if (currentPaymentMethod === 'paypal') {
                btn.innerHTML = '🅿️ Pay $' + formatted + ' with PayPal';
              } else if (currentPaymentMethod === 'klarna') {
                btn.innerHTML = '🛍️ Pay with Klarna • $' + formatted;
              } else if (currentPaymentMethod === 'cashapp') {
                btn.innerHTML = '💚 Pay with Cash App • $' + formatted;
              } else {
                btn.innerHTML = '🐺 Back ' + gameTitle + ' with Card • $' + formatted;
              }
            }
          }

          document.addEventListener('DOMContentLoaded', function() {
            var input = document.getElementById('donationAmountInput');
            if (input) {
              input.addEventListener('input', updateDonationUI);
              input.addEventListener('change', updateDonationUI);
            }
            updateDonationUI();
          });
        </script>
      <% } %>

      <!-- ---------- long-form body ---------- -->
      <div class="prose">
        <h2>About this game</h2>
        <p class="body-copy"><%= game.description %></p>

        <% if (features.length) { %>
          <h3>Key features</h3>
          <ul class="feature-list">
            <% features.forEach(function (f) { %><li><%= f %></li><% }) %>
          </ul>
        <% } %>

        <% if (game.sysMin || game.sysRec) { %>
          <h3>System requirements</h3>
          <div class="specs">
            <div class="spec-col">
              <h4>Minimum</h4>
              <pre><%= game.sysMin || 'To be announced.' %></pre>
            </div>
            <div class="spec-col">
              <h4>Recommended</h4>
              <pre><%= game.sysRec || 'To be announced.' %></pre>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- ---------- info sidebar ---------- -->
    <aside class="info-panel">
      <div class="info-capsule">
        <% if (game.coverImage) { %>
          <img src="<%= resolveUploadUrl('covers', game.coverImage) %>" alt="<%= game.title %> cover art" style="object-position:<%= game.coverPos %>" referrerpolicy="no-referrer" />
        <% } else { %>
          <span class="media-empty"><%- include('partials/logo', { id: 'cap', size: 44 }) %></span>
        <% } %>
      </div>

      <div class="info-pad">
        <p class="info-tagline"><%= game.tagline %></p>

        <dl class="info-rows">
          <% if (game.wishlistEnabled) { %>
          <div class="info-row">
            <dt>Wishlists</dt>
            <dd><strong><%= game.wishlistCount.toLocaleString() %></strong></dd>
          </div>
          <% } %>
          <div class="info-row">
            <dt>Status</dt>
            <dd><%= game.statusLabel %></dd>
          </div>
          <% if (game.releaseDate) { %>
          <div class="info-row">
            <dt>Release</dt>
            <dd><%= game.releaseDate %></dd>
          </div>
          <% } %>
          <% if (game.developer) { %>
          <div class="info-row">
            <dt>Developer</dt>
            <dd><%= game.developer %></dd>
          </div>
          <% } %>
          <% if (game.publisher) { %>
          <div class="info-row">
            <dt>Publisher</dt>
            <dd><%= game.publisher %></dd>
          </div>
          <% } %>
          <% if (game.platforms && game.platforms.length) { %>
          <div class="info-row">
            <dt>Platforms</dt>
            <dd><%= game.platforms.join(', ') %></dd>
          </div>
          <% } %>
          <% if (game.showPrice) { %>
          <div class="info-row">
            <dt>Price</dt>
            <dd><%= game.pricingType === 'free' ? 'Free' : '$' + Number(game.price).toFixed(2) %></dd>
          </div>
          <% } %>
        </dl>

        <% if (tags.length) { %>
          <div class="tag-cloud">
            <% tags.forEach(function (t) { %><span class="chip"><%= t %></span><% }) %>
          </div>
        <% } %>

        <% if (game.wishlistEnabled) { %>
          <div class="wish-inline">
            <div class="wish-count-big">
              <b><%= game.wishlistCount.toLocaleString() %></b>
              <span>people want this game</span>
            </div>
            <%- include('partials/wishlist-form', { game: game, compact: false }) %>
          </div>
        <% } %>
      </div>

      <% if (others.length) { %>
        <div class="side-block">
          <h4>More from <%= studio.name %></h4>
          <% others.forEach(function (g) { %>
            <a class="mini-game" href="/games/<%= g.slug %>">
              <span class="mini-thumb">
                <% if (g.coverImage) { %>
                  <img src="<%= resolveUploadUrl('covers', g.coverImage) %>" alt="" style="object-position:<%= g.coverPos %>" referrerpolicy="no-referrer" />
                <% } else { %>
                  <span class="media-empty"></span>
                <% } %>
              </span>
              <span class="mini-meta">
                <h5><%= g.title %></h5>
                <span><%= g.showPrice ? (g.pricingType === 'free' ? 'Free' : '$' + Number(g.price).toFixed(2)) : g.statusLabel %></span>
              </span>
            </a>
          <% }) %>
        </div>
      <% } %>

      <% if (game.externalStoreUrl) { %>
        <div class="side-block">
          <h4>Also available on</h4>
          <a href="<%= game.externalStoreUrl %>" target="_blank" rel="noopener" class="btn btn-ghost btn-block btn-sm">Visit store page</a>
        </div>
      <% } %>
    </aside>
  </div>
</section>

<% var voiceList = (typeof voices !== 'undefined' && voices) ? voices : []; %>
<% var devlogList = (typeof devlog !== 'undefined' && devlog) ? devlog : []; %>
<% var devlogCount = (typeof devlogTotal !== 'undefined') ? devlogTotal : devlogList.length; %>

<% if (voiceList.length) { %>
  <section class="section voices-section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">From the people making it</p>
        <h2>Why we love building <%= game.title %></h2>
        <p class="lead">The team, unscripted, on what this project actually feels like to work on.</p>
      </div>

      <div class="voices-grid">
        <% voiceList.forEach(function (v) { %>
          <article class="voice-card<%= (!v.video && !v.photo) ? ' is-text-only' : '' %>">
            <% if (v.video) { %>
              <div class="voice-video">
                <% if (v.video.mode === 'iframe') { %>
                  <iframe src="<%= v.video.src %>" title="<%= v.name %> on <%= game.title %>"
                          allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy" referrerpolicy="no-referrer"></iframe>
                <% } else { %>
                  <video src="<%= v.video.src %>" controls preload="metadata"
                         <%= v.photo ? 'poster=' + resolveUploadUrl('team', v.photo) : '' %>></video>
                <% } %>
              </div>
            <% } else if (v.photo) { %>
              <div class="voice-video voice-photo-only">
                <img src="<%= resolveUploadUrl('team', v.photo) %>" alt="<%= v.name %>" loading="lazy" referrerpolicy="no-referrer" />
              </div>
            <% } %>

            <div class="voice-body">
              <% if (v.quote) { %><blockquote class="voice-quote"><%= v.quote %></blockquote><% } %>
              <div class="voice-who">
                <% if (v.photo && v.video) { %>
                  <img class="voice-avatar" src="<%= resolveUploadUrl('team', v.photo) %>" alt="" loading="lazy" referrerpolicy="no-referrer" />
                <% } %>
                <div>
                  <span class="voice-name"><%= v.name %></span>
                  <% if (v.role) { %><span class="voice-role"><%= v.role %></span><% } %>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>

<% if (devlogList.length) { %>
  <section class="section">
    <div class="container">
      <div class="section-head row-head">
        <div>
          <p class="eyebrow">Development log</p>
          <h2>What we've been doing</h2>
        </div>
        <% if (devlogCount > devlogList.length) { %>
          <a href="/devlog/game/<%= game.slug %>" class="btn btn-ghost btn-sm">
            All <%= devlogCount %> posts
          </a>
        <% } %>
      </div>

      <div class="devlog-list">
        <% devlogList.forEach(function (e) { %>
          <article class="devlog-card">
            <a class="devlog-card-media" href="/devlog/<%= e.id %>">
              <% if (e.media.length && e.media[0].type === 'image') { %>
                <img src="<%= e.media[0].src %>" alt="" loading="lazy" />
              <% } else if (e.media.length) { %>
                <span class="media-empty devlog-video-flag">
                  <svg width="26" height="30" viewBox="0 0 12 14" fill="currentColor" aria-hidden="true"><path d="M0 0l12 7-12 7z"/></svg>
                </span>
              <% } else { %>
                <span class="media-empty"><%- include('partials/logo', { id: 'gdl' + e.id, size: 30 }) %></span>
              <% } %>
            </a>
            <div class="devlog-card-body">
              <div class="devlog-meta">
                <time datetime="<%= e.dateInput %>"><%= e.dateLabel %></time>
              </div>
              <h3><a href="/devlog/<%= e.id %>"><%= e.title %></a></h3>
              <p><%= e.excerpt %><%= e.body && e.body.length > 190 ? '…' : '' %></p>
              <div class="devlog-card-foot">
                <% if (e.author) { %><span class="muted small">by <%= e.author %></span><% } %>
                <a href="/devlog/<%= e.id %>" class="text-link">Read the post &rarr;</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>

<% var fbTopics = (typeof feedbackTopics !== 'undefined' && feedbackTopics) ? feedbackTopics : []; %>
<% var fbStats = (typeof feedbackStats !== 'undefined' && feedbackStats) ? feedbackStats : null; %>

<section class="section feedback-section" id="feedback">
  <div class="container">
    <div class="feedback-wrap">
      <div class="feedback-intro">
        <p class="eyebrow">Tell us the truth</p>
        <h2>Feedback on <%= game.title %></h2>
        <p class="lead">
          <%= game.isReleased
              ? 'Played it? We want to know what landed and what did not.'
              : 'This game is still being made, which means your opinion can still change it. That is the point of asking now.' %>
        </p>

        <% if (fbStats && fbStats.total) { %>
          <div class="feedback-stats">
            <div>
              <span class="fb-num"><%= fbStats.total %></span>
              <span class="fb-label"><%= fbStats.total === 1 ? 'response' : 'responses' %></span>
            </div>
            <% if (fbStats.rated) { %>
              <div>
                <span class="fb-num"><%= fbStats.average %><span class="fb-of">/5</span></span>
                <span class="fb-label">average from <%= fbStats.rated %></span>
              </div>
            <% } %>
          </div>
        <% } %>

        <p class="muted small">
          Feedback goes straight to the team — it is not published on the site,
          so you can be blunt without it becoming a public review.
        </p>
      </div>

      <form class="feedback-form" method="POST" action="/games/<%= game.slug %>/feedback">
        <div class="fb-rating">
          <span class="wl-label">How is it looking so far?</span>
          <div class="fb-stars">
            <% [5,4,3,2,1].forEach(function (n) { %>
              <input type="radio" name="rating" id="fb<%= game.id %>-<%= n %>" value="<%= n %>" />
              <label for="fb<%= game.id %>-<%= n %>" title="<%= n %> out of 5">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/>
                </svg>
              </label>
            <% }) %>
          </div>
          <span class="hint">Optional — skip it if you would rather just write.</span>
        </div>

        <label class="wl-field">
          <span class="wl-label">What is this about?</span>
          <select name="topic">
            <% fbTopics.forEach(function (t) { %><option value="<%= t %>"><%= t %></option><% }) %>
          </select>
        </label>

        <label class="wl-field">
          <span class="wl-label">Your feedback <em>required</em></span>
          <textarea name="message" rows="5" required maxlength="1500"
                    placeholder="What works, what does not, what you would change."></textarea>
        </label>

        <div class="wl-field-row">
          <label class="wl-field">
            <span class="wl-label">Name</span>
            <input type="text" name="name" maxlength="60" placeholder="Optional" />
          </label>
          <label class="wl-field">
            <span class="wl-label">Email</span>
            <input type="email" name="email" maxlength="160" placeholder="Only if you want a reply" />
          </label>
        </div>

        <label class="wl-consent">
          <input type="checkbox" name="canReply" />
          <span>
            You can email me back about this.
            <span class="wl-consent-hint">We only use it to reply to this feedback.</span>
          </span>
        </label>

        <button type="submit" class="btn btn-primary btn-block">Send feedback</button>
      </form>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cta">
      <h2><%= game.isReleased ? 'Enjoying the game?' : "Don't miss the launch" %></h2>
      <p class="lead">
        <%= game.isReleased
            ? 'Tell a friend, leave a review, and keep an eye on what we build next.'
            : 'Wishlisting helps us show publishers there is real demand — it takes ten seconds.' %>
      </p>
      <a href="/wishlist" class="btn btn-primary btn-lg">See all our games</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
