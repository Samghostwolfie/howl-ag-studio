<%- include('partials/header') %>

<%
  var inDev     = games.filter(function (g) { return g.status === 'development' || g.status === 'prototype'; });
  var shipped   = games.filter(function (g) { return g.status === 'released'; });
  var playable  = games.filter(function (g) { return g.status === 'demo' || g.status === 'released'; });
  var live      = games.filter(function (g) { return g.status !== 'archived'; });

  // Goals are editable in Settings. Until they're filled in, we show nothing rather
  // than inventing ambitions on the studio's behalf.
  var goals = (studio.goals || []).filter(function (g) { return g && g.label; });
  var heroLine = studio.heroLine || studio.tagline || '';
%>

<!-- ============ INTERACTIVE HERO ============ -->
<section class="hero-v4" id="hero">
  <canvas class="hero-canvas" id="heroCanvas" aria-hidden="true"></canvas>

  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-v4-inner">
    <div class="hero-mark" aria-hidden="true">
      <img src="/img/logo-wolf-512.png" alt="" width="120" height="120" />
    </div>

    <p class="eyebrow hero-eyebrow"><%= studio.name %></p>

    <h1 class="hero-v4-title" id="heroTitle">
      <span class="hv-line"><%= studio.name.split(' ')[0] || 'Howl' %></span>
      <span class="hv-line hv-accent"><%= studio.name.split(' ').slice(1).join(' ') || 'Studio' %></span>
    </h1>

    <% if (heroLine) { %>
      <p class="hero-v4-line"><%= heroLine %></p>
    <% } %>

    <% if (studio.pitch) { %>
      <p class="hero-v4-pitch"><%= studio.pitch %></p>
    <% } %>

    <div class="hero-v4-actions">
      <% if (live.length) { %>
        <a href="/work" class="btn btn-primary btn-lg">See what we're making</a>
      <% } %>
      <a href="/about" class="btn btn-ghost btn-lg">Who we are</a>
    </div>

    <!-- honest, self-calculating status line: these numbers come from the site's own data -->
    <div class="hero-facts">
      <div class="hero-fact">
        <span class="hf-num"><%= live.length %></span>
        <span class="hf-label"><%= live.length === 1 ? 'project' : 'projects' %></span>
      </div>
      <div class="hero-fact">
        <span class="hf-num"><%= inDev.length %></span>
        <span class="hf-label">in development</span>
      </div>
      <div class="hero-fact">
        <span class="hf-num"><%= playable.length %></span>
        <span class="hf-label">playable now</span>
      </div>
      <% if (totalWishlist) { %>
        <div class="hero-fact">
          <span class="hf-num"><%= totalWishlist.toLocaleString() %></span>
          <span class="hf-label">wishlisted</span>
        </div>
      <% } %>
    </div>
  </div>

  <div class="hero-scroll-cue" aria-hidden="true"><span></span></div>
</section>

<!-- ============ THE HONEST BIT ============ -->
<section class="section straight-section">
  <span class="ghost-type" aria-hidden="true">Real</span>
  <div class="container">
    <div class="straight-grid">
      <div>
        <p class="eyebrow">Straight with you</p>
        <h2>Where we actually are</h2>
      </div>
      <div class="straight-body">
        <% if (studio.honesty) { %>
          <p class="lead body-copy"><%= studio.honesty %></p>
        <% } else { %>
          <p class="lead">
            We're a small independent team, not a studio with a back catalogue.
            <% if (shipped.length === 0 && inDev.length) { %>
              Nothing of ours has shipped yet — <%= inDev.length === 1 ? 'our first game is' : 'our games are' %>
              still in development, and this site is where you can watch that happen in the open.
            <% } else if (shipped.length) { %>
              We've released <%= shipped.length %> <%= shipped.length === 1 ? 'game' : 'games' %> so far,
              with <%= inDev.length %> more in development.
            <% } %>
          </p>
          <p>
            We'd rather show you an unfinished thing honestly than a finished-looking thing that isn't real.
            That's why the devlog exists, why the wishlist numbers are de-duplicated, and why the feedback
            form on every game page goes straight to us instead of being published as a review.
          </p>
        <% } %>

        <% if (studio.story) { %>
          <p class="body-copy straight-story"><%= studio.story %></p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- ============ GOALS ============ -->
<% if (goals.length) { %>
  <section class="section goals-section" id="goals">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What we're aiming at</p>
        <h2>Our goals</h2>
        <% if (studio.goalsIntro) { %><p class="lead"><%= studio.goalsIntro %></p><% } %>
      </div>

      <ol class="goal-list">
        <% goals.forEach(function (g, i) { %>
          <li class="goal-item">
            <span class="goal-num"><%= String(i + 1).padStart(2, '0') %></span>
            <div class="goal-text">
              <h3><%= g.label %></h3>
              <% if (g.detail) { %><p><%= g.detail %></p><% } %>
            </div>
          </li>
        <% }) %>
      </ol>
    </div>
  </section>
<% } %>

<!-- ============ FEATURED ============ -->
<% if (featured) { %>
  <section class="section featured-v4">
    <div class="container">
      <div class="section-head row-head">
        <div>
          <p class="eyebrow">Currently building</p>
          <h2><%= featured.title %></h2>
        </div>
        <span class="badge status-<%= featured.status %>"><%= featured.statusLabel %></span>
      </div>

      <div class="feat-grid">
        <a class="feat-art" href="/games/<%= featured.slug %>">
          <% if (featured.coverImage) { %>
            <img src="`<%= resolveUploadUrl('covers', featured.coverImage) %>`" alt="<%= featured.title %> key art"
                 style="object-position:<%= featured.coverPos %>" />
          <% } else { %>
            <span class="media-empty"><%- include('partials/logo', { id: 'feat', size: 72 }) %></span>
          <% } %>
        </a>

        <div class="feat-copy">
          <% if (featured.tagline) { %><p class="info-tagline"><%= featured.tagline %></p><% } %>
          <p class="body-copy feat-desc"><%= (featured.description || '').slice(0, 420) %><%= (featured.description || '').length > 420 ? '…' : '' %></p>

          <% if (featured.tags && featured.tags.length) { %>
            <div class="tag-cloud">
              <% featured.tags.forEach(function (t) { %><span class="chip"><%= t %></span><% }) %>
            </div>
          <% } %>

          <div class="feat-actions">
            <a href="/games/<%= featured.slug %>" class="btn btn-primary">Read more</a>
            <% if (featured.wishlistEnabled) { %>
              <a href="/wishlist" class="btn btn-ghost">Wishlist it</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>
<% } %>

<!-- ============ ALL PROJECTS ============ -->
<% if (live.length > 1) { %>
  <section class="section">
    <div class="container">
      <div class="section-head row-head">
        <div>
          <p class="eyebrow">Everything else</p>
          <h2>The rest of the slate</h2>
        </div>
        <a href="/work" class="btn btn-ghost btn-sm">All work</a>
      </div>

      <div class="games-grid">
        <% live.slice(0, 6).forEach(function (game) { %>
          <a class="game-card" href="/games/<%= game.slug %>">
            <div class="gc-media">
              <% if (game.coverImage) { %>
                <img src="`<%= resolveUploadUrl('covers', game.coverImage) %>`" alt="<%= game.title %> cover art"
                     style="object-position:<%= game.coverPos %>" loading="lazy" />
              <% } else { %>
                <span class="media-empty"><%- include('partials/logo', { id: 'gc' + game.id, size: 40 }) %></span>
              <% } %>
              <span class="badge status-<%= game.status %>"><%= game.statusLabel %></span>
            </div>
            <div class="gc-body">
              <h3><%= game.title %></h3>
              <p class="tag"><%= game.genre %></p>
              <p><%= game.tagline %></p>
              <div class="gc-foot">
                <% if (game.showPrice) { %>
                  <span class="gc-price"><%= game.pricingType === 'free' ? 'FREE' : '$' + Number(game.price).toFixed(2) %></span>
                <% } else { %>
                  <span class="gc-price"><%= game.statusLabel %></span>
                <% } %>
                <% if (game.wishlistEnabled) { %>
                  <span class="gc-wish"><%= game.wishlistCount.toLocaleString() %> wishlists</span>
                <% } %>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>

<!-- ============ CTA ============ -->
<section class="section">
  <div class="container">
    <div class="cta">
      <h2>Watch it get made</h2>
      <p class="lead">
        The devlog is where the honest version lives — what broke, what we cut, what finally worked.
        Wishlisting tells us, and any publisher we talk to, that someone is actually waiting.
      </p>
      <div class="hero-v4-actions" style="justify-content:center">
        <a href="/wishlist" class="btn btn-primary btn-lg">Wishlist a game</a>
        <a href="/devlog" class="btn btn-ghost btn-lg">Read the devlog</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
